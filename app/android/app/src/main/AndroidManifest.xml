<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Without these, Geolocator.requestPermission() has nothing to actually
         request — Android never shows the runtime permission dialog for a
         permission the app didn't declare wanting, so location fetch silently
         behaved as permanently denied on every device regardless of what the
         user chose (tester feedback B4: "current location not picking up").
         COARSE is requested alongside FINE since Android 12+ lets the user
         grant only approximate location — geolocator handles either grant. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <application
        android:label="sokoni"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Now that google-services.json exists, Firebase's Android SDK
             auto-initialises FirebaseMessaging via a ContentProvider at
             process start — before Dart even runs, independent of and
             earlier than PushService.registerDevice()'s explicit
             Firebase.initializeApp() call. That auto-init tries to
             register for an FCM token immediately, which can hang on a
             device with no network or stale/missing Play Services and
             was blocking the app from ever reaching its first frame.
             Push registration is meant to be explicit and deferred until
             after sign-in anyway (see PushService) — this defers FCM's
             own init to match, rather than firing automatically at
             startup. Does not affect explicit calls to
             FirebaseMessaging.instance later. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
