APP_NAME=Sokoni
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev default is 'log' (mail bodies land in storage/logs, nothing
# actually sent) — production sets MAIL_MAILER=smtp against the cPanel
# mailbox (see docs/DEPLOY.md): host/port/username/password from that
# mailbox, port 465 with SSL encryption.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mail.sokoni.co.tz
MAIL_PORT=465
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@sokoni.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==== Social sign-in — BLOCKER, see BLOCKERS.md item 3 ====
# GOOGLE_CLIENT_ID is shared by both flows below (the app's native Google
# Sign-In, which only ever needs a client ID to check the token audience;
# and the website's own OAuth redirect, via Socialite, which additionally
# needs CLIENT_SECRET + REDIRECT_URI — see GoogleAuthController, which
# hides the website's "Sign in with Google" button entirely until all
# three of these are set, rather than sending a visitor into a 404/500).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match one of the "Authorized redirect URIs" configured on
# the same OAuth client in Google Cloud Console, e.g.
# https://sokoni.co.tz/auth/google/callback in production.
GOOGLE_REDIRECT_URI=
APPLE_SERVICE_ID=

# ==== Firebase (push notifications) — BLOCKER, see BLOCKERS.md item 1 ====
# Path to a Firebase service-account JSON credentials file. kreait/laravel-firebase
# reads this to send FCM pushes; until it's supplied, NotificationService calls
# fail closed and are logged rather than sent (see BLOCKERS.md).
FIREBASE_CREDENTIALS=

# ==== Google Maps (server-side geocoding, if ever needed) — BLOCKER, see BLOCKERS.md item 2 ====
GOOGLE_MAPS_SERVER_KEY=

# ==== Phone OTP SMS delivery — see docs/SMS.md ====
# Picks the SmsGateway binding explicitly (AppServiceProvider) — leave unset
# to keep using LogSmsGateway (logs the code instead of sending it), which
# is what local dev and CI should always do. One of: textify, africastalking, beem.
SMS_DRIVER=textify

# Textify Africa (https://docs.textify.africa) — Sokoni's active SMS
# provider. TEXTIFY_API_KEY already carries its own txf_ prefix — paste it
# exactly as issued, never commit a real value here.
TEXTIFY_API_KEY=
TEXTIFY_SENDER_NAME=Textify
TEXTIFY_ENDPOINT=https://portal.textify.africa/api/v1/messages

# Africa's Talking — kept as a selectable alternative (SMS_DRIVER=africastalking),
# the previously-active provider (client account "skyfar",
# https://account.africastalking.com/apps/gladxtazoy).
AT_USERNAME=skyfar
AT_API_KEY=
AT_SENDER_ID=skyfar
AT_SANDBOX=false

# Beem Africa — kept as a selectable alternative (SMS_DRIVER=beem), not the
# client's actual provider. Both keys required when selected.
BEEM_SMS_API_KEY=
BEEM_SMS_SECRET_KEY=
BEEM_SMS_SENDER_ID=INFO

# ==== Public media disk (cPanel deploy target — see docs/DEPLOY.md) ====
# Local dev leaves both unset (defaults to the standard storage_path()-based
# `public` disk). Production sets both to point uploaded media at a real
# path under public_html, since symlinks (storage:link) are often blocked
# on shared hosting. D2 (tester feedback): this value has moved more than
# once (beta subdomain <-> root domain) — every media URL is stored as a
# FULL absolute URL baked in at upload time (product_media, seller logos,
# avatars, ...), so changing this value again does nothing for rows
# already uploaded; run `setup.php?step=rewrite-media-host&from=&to=`
# (see that step's own comment) after any change to actually fix them.
# The docroot actually live right now is /home/sokoftsn/beta.sokoni.co.tz
# (a single combined docroot, not yet split into api./root subdomains the
# way docs/DEPLOY.md's eventual production runbook describes) — so on
# that host, both of these should be beta.sokoni.co.tz-based:
#   PUBLIC_UPLOADS_ROOT=/home/sokoftsn/beta.sokoni.co.tz/uploads
#   PUBLIC_UPLOADS_URL=https://beta.sokoni.co.tz/uploads
PUBLIC_UPLOADS_ROOT=
PUBLIC_UPLOADS_URL="${APP_URL}/storage"

# ==== Admin panel platform defaults — see config/sokoni.php and the admin
# Settings page (App\Support\Settings), which overrides these at runtime
# via the `settings` table. All optional; every one has a sensible default. ====
SOKONI_SEARCH_RADIUS_KM=5
SOKONI_MAX_MEDIA_PER_PRODUCT=8
SOKONI_OFFER_MAX_DURATION_DAYS=7
SOKONI_REPORT_AUTO_HIDE_THRESHOLD=3

# ==== Website footer/header links — all optional. Leave unset to hide the
# icon or button entirely rather than link to a dead or generic page. There
# is no SOKONI_APP_APP_STORE key — no iOS build exists yet; add one only
# once a real App Store listing does (see DECISIONS.md). ====
SOKONI_SOCIAL_FACEBOOK=
SOKONI_SOCIAL_INSTAGRAM=
SOKONI_SOCIAL_X=
SOKONI_APP_GOOGLE_PLAY=

# Real support address on the production domain — not hidden when unset
# (unlike the links above), just overridable without a code deploy.
SOKONI_SUPPORT_EMAIL=support@sokoni.co.tz

# Hostname the beta deployment is served from. Requests to this exact host
# get an X-Robots-Tag: noindex, nofollow header (see NoindexBetaHost) so
# Google can still crawl it (unlike a robots.txt Disallow) but never
# indexes it. Leave as-is in production — beta.sokoni.co.tz will simply
# never match the production request host.
SOKONI_BETA_HOSTNAME=beta.sokoni.co.tz

# ==== TEMPORARY — gates /_diagnostic/log (see routes/web.php). Unset =
# the route always 404s. Remove this line along with the route and
# DiagnosticLogController once the production-only /c/{category} 500 is
# confirmed and fixed. Use a long random value, not the placeholder below. ====
# DIAGNOSTIC_LOG_TOKEN=REPLACE_ME
