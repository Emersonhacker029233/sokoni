APP_NAME=Sokoni
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==== Social sign-in — BLOCKER, see BLOCKERS.md item 3 ====
GOOGLE_CLIENT_ID=
APPLE_SERVICE_ID=

# ==== Firebase (push notifications) — BLOCKER, see BLOCKERS.md item 1 ====
# Path to a Firebase service-account JSON credentials file. kreait/laravel-firebase
# reads this to send FCM pushes; until it's supplied, NotificationService calls
# fail closed and are logged rather than sent (see BLOCKERS.md).
FIREBASE_CREDENTIALS=

# ==== Google Maps (server-side geocoding, if ever needed) — BLOCKER, see BLOCKERS.md item 2 ====
GOOGLE_MAPS_SERVER_KEY=

# ==== Phone OTP SMS delivery — see docs/SMS.md ====
# Beem Africa send-SMS credentials. Both must be set for BeemSmsGateway to be
# bound; leave blank to keep using LogSmsGateway (logs the code instead of
# sending it — see AppServiceProvider).
BEEM_SMS_API_KEY=
BEEM_SMS_SECRET_KEY=
BEEM_SMS_SENDER_ID=INFO

# ==== Public media disk (cPanel deploy target — see docs/DEPLOY.md) ====
# Local dev leaves both unset (defaults to the standard storage_path()-based
# `public` disk). Production sets both to point uploaded media at a real
# path under public_html, since symlinks (storage:link) are often blocked
# on shared hosting:
#   PUBLIC_UPLOADS_ROOT=/home/sokoftsn/public_html/uploads
#   PUBLIC_UPLOADS_URL=https://sokoni.co.tz/uploads
PUBLIC_UPLOADS_ROOT=
PUBLIC_UPLOADS_URL="${APP_URL}/storage"

# ==== Admin panel platform defaults — see config/sokoni.php and the admin
# Settings page (App\Support\Settings), which overrides these at runtime
# via the `settings` table. All optional; every one has a sensible default. ====
SOKONI_SEARCH_RADIUS_KM=5
SOKONI_MAX_MEDIA_PER_PRODUCT=8
SOKONI_OFFER_MAX_DURATION_DAYS=7
SOKONI_REPORT_AUTO_HIDE_THRESHOLD=3
